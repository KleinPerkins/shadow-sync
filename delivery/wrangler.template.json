{
  "name": "OWNER_SELECTS_WORKER_NAME",
  "main": "ABSOLUTE_PATH_TO_delivery/worker.mjs",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "routes": [],
  "vars": {
    "UPDATE_ORIGIN": "https://OWNER_APPROVED_DOWNLOAD_HOST"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "OWNER_PRIVATE_DATABASE_NAME",
      "database_id": "OWNER_PRIVATE_DATABASE_ID"
    }
  ],
  "assets": {
    "directory": "OWNER_CANONICAL_PRIVATE_ASSET_DIRECTORY",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
